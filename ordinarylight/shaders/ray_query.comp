#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT scene_tlas;
layout(set = 0, binding = 1, std430) buffer OutputPixels {
    uint pixels[];
};
struct MaterialData {
    vec4 base_roughness;
    vec4 emission_metallic;
    vec4 attenuation_transmission;
    vec4 ior_distance;
    vec4 texture_indices;
    vec4 texture_parameters;
};
struct MaterialEvaluation {
    vec3 base_color;
    vec3 emission;
    float metallic;
    float roughness;
    float transmission;
    float ior;
    vec3 attenuation_color;
    float attenuation_distance;
    float custom_scattering;
    vec3 weight;
    vec3 next_direction;
    float event;
    float pdf;
};
float waveFresnelSchlick(float cosine, float ior_from, float ior_to);
vec3 waveCosineHemisphere(vec3 normal, float random_u, float random_v);
// WAVE_RENDER_MATERIAL_BEGIN
MaterialEvaluation evaluateMaterial(MaterialData material, vec3 normal, vec2 uv, vec3 direction, bool entering, float random_u, float random_v, float bounce_index, float current_ior, float exterior_ior)
{
    MaterialEvaluation result;
    result.base_color = material.base_roughness.rgb;
    result.emission = material.emission_metallic.rgb;
    result.metallic = material.emission_metallic.a;
    result.roughness = material.base_roughness.a;
    result.transmission = material.attenuation_transmission.a;
    result.ior = material.ior_distance.x;
    result.attenuation_color = material.attenuation_transmission.rgb;
    result.attenuation_distance = material.ior_distance.y;
    result.custom_scattering = 0.0;
    result.weight = vec3(0.0);
    result.next_direction = direction;
    result.event = 0.0;
    result.pdf = 1.0;
    return result;
}
// WAVE_RENDER_MATERIAL_END
float waveFresnelSchlick(float cosine, float ior_from, float ior_to)
{
    float r0 = (ior_from - ior_to) / max(ior_from + ior_to, 0.000001);
    r0 *= r0;
    return r0 + (1.0 - r0) * pow(1.0 - clamp(cosine, 0.0, 1.0), 5.0);
}

vec3 waveCosineHemisphere(vec3 normal, float random_u, float random_v)
{
    float radius = sqrt(random_u);
    float phi = 6.28318530718 * random_v;
    vec3 tangent = normalize(abs(normal.z) < 0.999 ? cross(normal, vec3(0.0, 0.0, 1.0)) : cross(normal, vec3(0.0, 1.0, 0.0)));
    vec3 bitangent = cross(normal, tangent);
    return normalize(tangent * (radius * cos(phi)) + bitangent * (radius * sin(phi)) + normal * sqrt(max(0.0, 1.0 - random_u)));
}

float waveRandom(inout uint state)
{
    state = state * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    word = (word >> 22u) ^ word;
    return float(word) * (1.0 / 4294967296.0);
}
layout(set = 0, binding = 2, std430) readonly buffer MaterialBuffer {
    MaterialData materials[];
};
layout(set = 0, binding = 3, std430) readonly buffer VertexBuffer {
    vec4 vertices[];
};
struct PointLightData {
    vec4 position_type;
    vec4 direction_range;
    vec4 color_intensity;
    vec4 spot_parameters;
};
layout(set = 0, binding = 10, std430) readonly buffer PointLightBuffer {
    PointLightData point_lights[];
};
struct AreaLightData {
    vec4 a;
    vec4 b;
    vec4 c;
    vec4 emission_area;
    vec4 distribution;
};
layout(set = 0, binding = 11, std430) readonly buffer AreaLightBuffer {
    AreaLightData area_lights[];
};
struct VertexAttributeData { vec4 normal; vec4 texcoord; vec4 tangent; };
layout(set = 0, binding = 14, std430) readonly buffer AttributeBuffer {
    VertexAttributeData attributes[];
};

layout(push_constant) uniform Camera {
    vec4 origin;
    vec4 forward;
    vec4 right;
    vec4 up;
    vec4 overlay; // z: maximum path segments
} camera;

vec3 environmentColor(vec3 direction)
{
    float blend = clamp(0.5 * (direction.y + 1.0), 0.0, 1.0);
    return mix(vec3(0.8), vec3(0.2, 0.4, 0.9), blend);
}

void primaryRay(vec2 screen, out vec3 origin, out vec3 direction)
{
    int projection = int(camera.up.w + 0.5);
    origin = camera.origin.xyz;
    if (projection == 1) {
        origin += screen.x * camera.right.xyz + screen.y * camera.up.xyz;
        direction = normalize(camera.forward.xyz);
    } else if (projection == 2) {
        float yaw = screen.x * length(camera.right.xyz);
        float pitch = screen.y * length(camera.up.xyz);
        direction = normalize(
            normalize(camera.forward.xyz) * cos(pitch) * cos(yaw)
            + normalize(camera.right.xyz) * cos(pitch) * sin(yaw)
            + normalize(camera.up.xyz) * sin(pitch));
    } else {
        direction = normalize(camera.forward.xyz
            + screen.x * camera.right.xyz + screen.y * camera.up.xyz);
    }
}

vec3 tracePath(vec3 origin, vec3 direction, uint random_state)
{
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    int max_bounces = clamp(int(camera.overlay.z), 1, 16);
    float medium_iors[8];
    medium_iors[0] = 1.0;
    int medium_depth = 1;
    for (int bounce = 0; bounce < 16; ++bounce) {
        if (bounce >= max_bounces) break;
        rayQueryEXT query;
        rayQueryInitializeEXT(query, scene_tlas, gl_RayFlagsOpaqueEXT, 0xff,
                              origin, 0.001, direction, 10000.0);
        while (rayQueryProceedEXT(query)) {}
        if (rayQueryGetIntersectionTypeEXT(query, true) ==
            gl_RayQueryCommittedIntersectionNoneEXT) {
            radiance += throughput * environmentColor(direction);
            break;
        }
        uint primitive = rayQueryGetIntersectionPrimitiveIndexEXT(query, true)
            + rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
        float distance = rayQueryGetIntersectionTEXT(query, true);
        vec3 hit = origin + direction * distance;
        vec3 a = vertices[primitive * 3 + 0].xyz;
        vec3 b = vertices[primitive * 3 + 1].xyz;
        vec3 c = vertices[primitive * 3 + 2].xyz;
        vec3 geometric_normal = normalize(cross(b - a, c - a));
        bool entering = dot(direction, geometric_normal) < 0.0;
        vec2 barycentric = rayQueryGetIntersectionBarycentricsEXT(query, true);
        vec3 weights = vec3(1.0 - barycentric.x - barycentric.y,
                            barycentric.x, barycentric.y);
        vec3 shading_normal = normalize(
            attributes[primitive * 3 + 0].normal.xyz * weights.x +
            attributes[primitive * 3 + 1].normal.xyz * weights.y +
            attributes[primitive * 3 + 2].normal.xyz * weights.z
        );
        if (dot(shading_normal, geometric_normal) < 0.0)
            shading_normal = -shading_normal;
        vec3 normal = entering ? shading_normal : -shading_normal;
        vec2 uv = attributes[primitive * 3 + 0].texcoord.xy * weights.x +
                  attributes[primitive * 3 + 1].texcoord.xy * weights.y +
                  attributes[primitive * 3 + 2].texcoord.xy * weights.z;
        MaterialData material = materials[primitive];
        float current_ior = medium_iors[medium_depth - 1];
        float exterior_ior = entering ? max(material.ior_distance.x, 1.0001) :
            (medium_depth > 1 ? medium_iors[medium_depth - 2] : 1.0);
        float random_u = waveRandom(random_state);
        float random_v = waveRandom(random_state);
        MaterialEvaluation evaluated = evaluateMaterial(
            material, normal, uv, direction, entering, random_u, random_v,
            float(bounce), current_ior, exterior_ior
        );
        vec3 base = evaluated.base_color;
        if (entering || material.ior_distance.w > 0.5)
            radiance += throughput * evaluated.emission;
        if (evaluated.custom_scattering > 0.5) {
            int event = int(evaluated.event + 0.5);
            if (event == 0)
                break;
            direction = normalize(evaluated.next_direction);
            origin = hit + direction * 0.002;
            throughput *= evaluated.weight / max(evaluated.pdf, 0.000001);
            if (event == 3) {
                if (entering && medium_depth < 8)
                    medium_iors[medium_depth++] = max(material.ior_distance.x, 1.0001);
                else if (!entering && medium_depth > 1)
                    medium_depth--;
            }
            continue;
        }
        float transmission = evaluated.transmission;
        if (transmission > 0.001) {
            float target_ior = entering ? max(evaluated.ior, 1.0001) : exterior_ior;
            float eta = current_ior / target_ior;
            vec3 next_direction = refract(direction, normal, eta);
            if (dot(next_direction, next_direction) < 0.01)
                next_direction = reflect(direction, normal);
            direction = normalize(next_direction);
            origin = hit + direction * 0.002;
            throughput *= mix(vec3(1.0), base, 0.2) * transmission;
            if (entering && medium_depth < 8)
                medium_iors[medium_depth++] = target_ior;
            else if (!entering && medium_depth > 1)
                medium_depth--;
            continue;
        }
        float metallic = evaluated.metallic;
        if (metallic > 0.5 && bounce + 1 < max_bounces) {
            direction = normalize(reflect(direction, normal));
            origin = hit + direction * 0.002;
            throughput *= base;
            continue;
        }
        vec3 light_direction = normalize(vec3(-0.45, 0.8, 0.35));
        float diffuse = max(dot(normal, light_direction), 0.0);
        radiance += throughput * base * (0.10 + 0.90 * diffuse);
        break;
    }
    return radiance;
}

void main()
{
    uvec2 pixel = gl_GlobalInvocationID.xy;
    uvec2 size = uvec2(camera.origin.w, camera.forward.w);
    if (any(greaterThanEqual(pixel, size)))
        return;

    int sample_count = clamp(int(camera.overlay.w), 1, 64);
    vec3 color = vec3(0.0);
    for (int sample_index = 0; sample_index < 64; ++sample_index) {
        if (sample_index >= sample_count) break;
        uint random_state = pixel.x * 1973u + pixel.y * 9277u + uint(sample_index) * 26699u + 911u;
        vec2 jitter = sample_count > 1 ? vec2(waveRandom(random_state), waveRandom(random_state)) : vec2(0.5);
        vec2 uv = (vec2(pixel) + jitter) / vec2(size);
        vec2 screen = uv * 2.0 - 1.0;
        screen.y = -screen.y;
        vec3 ray_origin, direction;
        primaryRay(screen, ray_origin, direction);
        color += tracePath(ray_origin, direction, random_state);
    }
    color /= float(sample_count);
    color = pow(color / (vec3(1.0) + color), vec3(1.0 / 2.2));
    pixels[pixel.y * size.x + pixel.x] = packUnorm4x8(vec4(color, 1.0));
}
