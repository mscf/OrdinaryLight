#version 460
#extension GL_EXT_ray_query : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct WaveRay {
    vec4 origin_tmin; vec4 direction_tmax;
    uint path_index; uint padding_a; uint padding_b; uint padding_c;
};
struct WaveHit {
    vec4 position_t; vec3 geometric_normal; uint primitive_index;
    vec2 barycentrics; uint ray_index; uint path_index;
};
struct MaterialData {
    vec4 base_roughness; vec4 emission_metallic;
    vec4 attenuation_transmission; vec4 ior_distance;
    vec4 texture_indices; vec4 texture_parameters;
};
layout(set = 0, binding = 0) uniform accelerationStructureEXT scene_tlas;
layout(set = 0, binding = 1, std430) readonly buffer RayQueue {
    uint ray_count; uint ray_capacity; uint ray_overflow; uint ray_padding;
    WaveRay rays[];
};
layout(set = 0, binding = 2, std430) buffer PlainHitQueue {
    uint plain_count; uint plain_capacity; uint plain_overflow; uint plain_padding;
    WaveHit plain_hits[];
};
layout(set = 0, binding = 3, std430) buffer TexturedHitQueue {
    uint textured_count; uint textured_capacity;
    uint textured_overflow; uint textured_padding;
    WaveHit textured_hits[];
};
layout(set = 0, binding = 4, std430) readonly buffer VertexBuffer {
    vec4 vertices[];
};
layout(set = 0, binding = 5, std430) readonly buffer MaterialBuffer {
    MaterialData materials[];
};

bool hasTextures(MaterialData material)
{
    return any(greaterThanEqual(material.texture_indices, vec4(0.0)))
        || material.texture_parameters.y >= 0.0
        || material.texture_parameters.w >= 0.0;
}

void main()
{
    uint ray_index = gl_GlobalInvocationID.x;
    if (ray_index >= min(ray_count, ray_capacity)) return;
    WaveRay ray = rays[ray_index];
    rayQueryEXT query;
    rayQueryInitializeEXT(
        query, scene_tlas, gl_RayFlagsOpaqueEXT, 0x01,
        ray.origin_tmin.xyz, ray.origin_tmin.w,
        ray.direction_tmax.xyz, ray.direction_tmax.w);
    while (rayQueryProceedEXT(query)) {}

    WaveHit hit;
    hit.path_index = ray.path_index;
    hit.ray_index = ray_index;
    bool textured = false;
    if (rayQueryGetIntersectionTypeEXT(query, true)
            == gl_RayQueryCommittedIntersectionTriangleEXT) {
        float distance = rayQueryGetIntersectionTEXT(query, true);
        uint primitive = rayQueryGetIntersectionPrimitiveIndexEXT(query, true)
            + rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
        vec3 a = vertices[primitive * 3u].xyz;
        vec3 b = vertices[primitive * 3u + 1u].xyz;
        vec3 c = vertices[primitive * 3u + 2u].xyz;
        hit.position_t = vec4(
            ray.origin_tmin.xyz + distance * ray.direction_tmax.xyz, distance);
        hit.geometric_normal = normalize(cross(b - a, c - a));
        hit.primitive_index = primitive;
        hit.barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, true);
        textured = hasTextures(materials[primitive]);
    } else {
        hit.position_t = vec4(0.0, 0.0, 0.0, -1.0);
        hit.geometric_normal = vec3(0.0);
        hit.primitive_index = 0xffffffffu;
        hit.barycentrics = vec2(0.0);
    }
    for (uint bucket = 0u; bucket < 2u; ++bucket) {
        bool belongs = textured == (bucket == 1u);
        uvec4 lane_mask = subgroupBallot(belongs);
        uint amount = subgroupBallotBitCount(lane_mask);
        uint base = 0u;
        if (subgroupElect() && amount > 0u)
            base = bucket == 1u
                ? atomicAdd(textured_count, amount)
                : atomicAdd(plain_count, amount);
        base = subgroupBroadcastFirst(base);
        if (!belongs) continue;
        uint output_index = base + subgroupBallotExclusiveBitCount(lane_mask);
        uint capacity = bucket == 1u ? textured_capacity : plain_capacity;
        if (output_index >= capacity) {
            if (bucket == 1u) atomicAdd(textured_overflow, 1u);
            else atomicAdd(plain_overflow, 1u);
            continue;
        }
        if (bucket == 1u) textured_hits[output_index] = hit;
        else plain_hits[output_index] = hit;
    }
}
