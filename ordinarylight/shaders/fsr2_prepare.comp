#version 460
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0,r32f) uniform readonly image2D view_z;
layout(binding=1,rgba16f) uniform readonly image2D motion;
layout(binding=2,rgba16f) uniform readonly image2D normal_roughness;
layout(binding=3,r32f) uniform writeonly image2D depth_out;
layout(binding=4,rg16f) uniform writeonly image2D motion_out;
layout(binding=5,r8) uniform writeonly image2D reactive_out;
layout(push_constant) uniform Constants { vec2 jitter; uvec2 extent; } push;
void main(){
 ivec2 p=ivec2(gl_GlobalInvocationID.xy);if(any(greaterThanEqual(p,ivec2(push.extent))))return;
 float z=imageLoad(view_z,p).r;vec4 m=imageLoad(motion,p);
 float depth=z>0.1?clamp((1000.0/z-0.1)/9999.9,0.0,1.0):0.0;
 imageStore(depth_out,p,vec4(depth));
 imageStore(motion_out,p,vec4(m.xy-push.jitter,0,0));
 float roughness=imageLoad(normal_roughness,p).w;
 // Conservative specular reactivity; this is not refracted-object motion.
 float reactive=(z<=0.0||m.z<=0.0)?1.0:(roughness<0.25?0.9:0.0);
 imageStore(reactive_out,p,vec4(reactive));
}
