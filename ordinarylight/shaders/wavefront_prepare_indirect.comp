#version 460

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer WorkQueue {
    uint count;
    uint capacity;
    uint overflow;
    uint queue_padding;
} work_queue;

layout(set = 0, binding = 1, std430) writeonly buffer DispatchArguments {
    uint group_count_x;
    uint group_count_y;
    uint group_count_z;
} dispatch_arguments;
void main()
{
    uint active_count = min(work_queue.count, work_queue.capacity);
    dispatch_arguments.group_count_x = (active_count + 63u) / 64u;
    dispatch_arguments.group_count_y = 1u;
    dispatch_arguments.group_count_z = 1u;
}
