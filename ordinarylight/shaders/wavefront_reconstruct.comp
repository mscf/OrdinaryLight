#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D hdr_image;
layout(set = 0, binding = 1, r32f) uniform readonly image2D position_image;
layout(set = 0, binding = 2, r32ui) uniform readonly uimage2D normal_image;
layout(set = 0, binding = 3, r11f_g11f_b10f) uniform readonly image2D previous_color;
layout(set = 0, binding = 4, r32f) uniform readonly image2D previous_position;
layout(set = 0, binding = 5, r32ui) uniform readonly uimage2D previous_normal;
layout(set = 0, binding = 6, r11f_g11f_b10f) uniform writeonly image2D history_color;
#if WAVE_BGRA_OUTPUT
layout(set = 0, binding = 7) uniform writeonly image2D output_images[8];
#else
layout(set = 0, binding = 7, rgba8) uniform writeonly image2D output_images[8];
#endif

struct CameraData { vec4 origin; vec4 forward; vec4 right; vec4 up; };
layout(set = 0, binding = 8, std430) readonly buffer PreviousCamera {
    CameraData previous_camera;
};
layout(set = 0, binding = 9, std430) readonly buffer CurrentCamera {
    CameraData current_camera;
};
layout(set = 0, binding = 10, r32ui) uniform readonly uimage2D material_image;

layout(push_constant) uniform PushConstants {
    float exposure;
    uint source_width;
    uint source_height;
    uint temporal_enabled;
    float history_weight;
    uint history_valid;
    uint diffuse_filter_enabled;
    float diffuse_filter_strength;
    uint variance_confidence_enabled;
    float variance_confidence_strength;
    uint material_confidence_enabled;
    float transmission_history_scale;
    uint reprojection_search_enabled;
    uint outlier_confidence_enabled;
    float outlier_confidence_strength;
    uint effect_padding;
    uvec4 effect_header[4];
    vec4 effect_color[4];
    vec4 effect_rect[4];
} push;

vec3 acesApproximation(vec3 color)
{
    const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
    return clamp((color * (a * color + b)) /
                 (color * (c * color + d) + e), 0.0, 1.0);
}

vec3 linearToSrgb(vec3 color)
{
    bvec3 low = lessThanEqual(color, vec3(0.0031308));
    return mix(1.055 * pow(color, vec3(1.0 / 2.4)) - 0.055,
               color * 12.92, low);
}

vec3 decodePackedOctNormal(vec2 encoded)
{
    vec3 normal = vec3(encoded, 1.0 - abs(encoded.x) - abs(encoded.y));
    if (normal.z < 0.0)
        normal.xy = (1.0 - abs(normal.yx)) * sign(normal.xy);
    return normalize(normal);
}

vec4 unpackNormalClass(uint packed)
{
    vec2 unit = vec2(
        float(packed & 0x7fffu),
        float((packed >> 15u) & 0x7fffu)
    ) / 32767.0;
    return vec4(
        decodePackedOctNormal(unit * 2.0 - 1.0),
        float(packed >> 30u));
}

vec4 loadCurrentNormal(ivec2 pixel)
{
    return unpackNormalClass(imageLoad(normal_image, pixel).x);
}

vec4 loadPreviousNormal(ivec2 pixel)
{
    return unpackNormalClass(imageLoad(previous_normal, pixel).x);
}

ivec2 clampSource(ivec2 pixel)
{
    return clamp(pixel, ivec2(0),
                 ivec2(int(push.source_width), int(push.source_height)) - 1);
}

vec3 loadHdr(ivec2 pixel) { return imageLoad(hdr_image, clampSource(pixel)).rgb; }

uint effectSlotAt(ivec2 pixel)
{
    uint signature = imageLoad(material_image, clampSource(pixel)).x;
    return signature == 0xffffffffu ? 0u : signature >> 29u;
}

vec3 worldPosition(
    CameraData camera_data, ivec2 pixel, ivec2 size, float ray_distance)
{
    vec2 ndc = ((vec2(pixel) + 0.5) / vec2(size)) * 2.0 - 1.0;
    float aspect = float(size.x) / float(size.y);
    vec3 direction = normalize(camera_data.forward.xyz
        + ndc.x * aspect * camera_data.right.xyz
        - ndc.y * camera_data.up.xyz);
    return camera_data.origin.xyz + direction * ray_distance;
}

vec4 loadCurrentPosition(ivec2 pixel, ivec2 size)
{
    float ray_distance = imageLoad(position_image, pixel).x;
    return vec4(
        worldPosition(current_camera, pixel, size, ray_distance), ray_distance
    );
}

vec4 loadPreviousPosition(ivec2 pixel, ivec2 size)
{
    float ray_distance = imageLoad(previous_position, pixel).x;
    return vec4(
        worldPosition(previous_camera, pixel, size, ray_distance), ray_distance
    );
}

vec3 bilinearHdr(vec2 source)
{
    ivec2 base = ivec2(floor(source));
    vec2 fraction = fract(source);
    vec3 top = mix(loadHdr(base), loadHdr(base + ivec2(1, 0)), fraction.x);
    vec3 bottom = mix(loadHdr(base + ivec2(0, 1)),
                      loadHdr(base + ivec2(1, 1)), fraction.x);
    return mix(top, bottom, fraction.y);
}

float luminance(vec3 color)
{
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

vec3 filterDiffuse(ivec2 center_pixel, vec4 center_position,
                   vec4 center_normal, vec3 unfiltered)
{
    vec3 weighted_color = vec3(0.0);
    float total_weight = 0.0;
    float luminance_sum = 0.0;
    float luminance_squared_sum = 0.0;
    float sample_weight_sum = 0.0;
    float distance_scale = max(0.03, abs(center_position.w) * 0.02);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 sample_pixel = clampSource(center_pixel + ivec2(x, y));
            vec4 sample_position = loadCurrentPosition(
                sample_pixel, ivec2(push.source_width, push.source_height));
            vec4 sample_normal = loadCurrentNormal(sample_pixel);
            if (sample_position.w < 0.0 || sample_normal.w > 0.5 ||
                    dot(sample_normal.xyz, sample_normal.xyz) < 0.5)
                continue;
            float normal_weight = pow(max(dot(
                normalize(center_normal.xyz), normalize(sample_normal.xyz)
            ), 0.0), 32.0);
            float position_delta = distance(
                center_position.xyz, sample_position.xyz
            ) / distance_scale;
            float position_weight = exp(-position_delta * position_delta);
            float kernel_weight = (x == 0 && y == 0) ? 1.0
                : ((x == 0 || y == 0) ? 0.75 : 0.5);
            float weight = kernel_weight * normal_weight * position_weight;
            vec3 sample_color = loadHdr(sample_pixel);
            weighted_color += sample_color * weight;
            total_weight += weight;
            float value = luminance(sample_color);
            luminance_sum += value * kernel_weight;
            luminance_squared_sum += value * value * kernel_weight;
            sample_weight_sum += kernel_weight;
        }
    }
    if (total_weight <= 0.0001 || sample_weight_sum <= 0.0001)
        return unfiltered;
    float mean = luminance_sum / sample_weight_sum;
    float variance = max(
        luminance_squared_sum / sample_weight_sum - mean * mean, 0.0
    );
    float relative_variance = variance / max(mean * mean, 0.001);
    float activation = push.diffuse_filter_strength
        * smoothstep(0.002, 0.05, relative_variance);
    return mix(unfiltered, weighted_color / total_weight, activation);
}

bool reproject(vec3 world_position, ivec2 output_size,
               out vec2 previous_pixel, out float previous_depth)
{
    vec3 offset = world_position - previous_camera.origin.xyz;
    previous_depth = dot(offset, previous_camera.forward.xyz);
    float scale = length(previous_camera.up.xyz);
    float aspect = float(output_size.x) / float(output_size.y);
    if (previous_depth <= 0.0001 || scale <= 0.0001)
        return false;
    vec2 ndc = vec2(
        dot(offset, normalize(previous_camera.right.xyz)) /
            (previous_depth * aspect * scale),
        -dot(offset, normalize(previous_camera.up.xyz)) /
            (previous_depth * scale)
    );
    vec2 pixel = (ndc * 0.5 + 0.5) * vec2(output_size) - 0.5;
    previous_pixel = pixel;
    return all(greaterThanEqual(pixel, vec2(-0.5))) &&
           all(lessThan(pixel, vec2(output_size) - 0.5));
}

void main()
{
    ivec2 output_pixel = ivec2(gl_GlobalInvocationID.xy);
    int output_index = clamp(int(current_camera.forward.w + 0.5), 0, 7);
    ivec2 output_size = imageSize(output_images[output_index]);
    if (any(greaterThanEqual(output_pixel, output_size)))
        return;

    vec2 source = (vec2(output_pixel) + 0.5)
        * vec2(push.source_width, push.source_height) / vec2(output_size) - 0.5;
    ivec2 source_pixel = clampSource(ivec2(round(source)));
    vec3 hdr = bilinearHdr(source);
    vec4 position_data = vec4(0.0, 0.0, 0.0, -1.0);
    vec4 normal_data = vec4(0.0);
    bool needs_gbuffer = push.temporal_enabled != 0u
        || push.diffuse_filter_enabled != 0u;
    if (needs_gbuffer) {
        position_data = loadCurrentPosition(
            source_pixel, ivec2(push.source_width, push.source_height));
        normal_data = loadCurrentNormal(source_pixel);
    }
    bool hit = needs_gbuffer && position_data.w >= 0.0
        && dot(normal_data.xyz, normal_data.xyz) > 0.5;

    float current_depth = hit
        ? dot(position_data.xyz - current_camera.origin.xyz,
              current_camera.forward.xyz) : -1.0;
    float surface_class = hit ? normal_data.w : -1.0;
    if (push.diffuse_filter_enabled != 0u && hit && surface_class < 0.5)
        hdr = filterDiffuse(source_pixel, position_data, normal_data, hdr);
    bool accepted = false;
    vec3 old_hdr = vec3(0.0);
    float history_confidence = 0.0;
    if (push.temporal_enabled != 0u && push.history_valid != 0u && hit) {
        vec2 previous_pixel;
        float projected_depth;
        if (reproject(position_data.xyz, output_size,
                      previous_pixel, projected_depth)) {
            vec2 previous_source = (previous_pixel + 0.5)
                * vec2(push.source_width, push.source_height) /
                  vec2(output_size) - 0.5;
            ivec2 previous_source_pixel = ivec2(round(previous_source));
            ivec2 previous_color_pixel = ivec2(round(previous_pixel));
            bool candidate_found = true;
            if (push.reprojection_search_enabled != 0u) {
                candidate_found = false;
                float best_score = 1e30;
                ivec2 source_size = ivec2(
                    int(push.source_width), int(push.source_height));
                ivec2 base = ivec2(floor(previous_source));
                for (int y = 0; y <= 1; ++y) {
                    for (int x = 0; x <= 1; ++x) {
                        ivec2 candidate = base + ivec2(x, y);
                        if (any(lessThan(candidate, ivec2(0))) ||
                                any(greaterThanEqual(candidate, source_size)))
                            continue;
                        vec4 candidate_position = loadPreviousPosition(
                            candidate, source_size);
                        vec4 candidate_normal = loadPreviousNormal(candidate);
                        if (candidate_position.w < 0.0 ||
                                dot(candidate_normal.xyz,
                                    candidate_normal.xyz) < 0.5 ||
                                abs(candidate_normal.w - surface_class) >= 0.25)
                            continue;
                        float candidate_position_error = distance(
                            candidate_position.xyz, position_data.xyz);
                        float candidate_normal_agreement = dot(
                            normalize(normal_data.xyz),
                            normalize(candidate_normal.xyz));
                        float position_tolerance = max(
                            0.03, projected_depth * 0.01);
                        if (candidate_position_error > position_tolerance ||
                                candidate_normal_agreement <= 0.9)
                            continue;
                        float score = candidate_position_error /
                            position_tolerance
                            + (1.0 - candidate_normal_agreement) * 10.0;
                        if (score < best_score) {
                            best_score = score;
                            candidate_found = true;
                            previous_source_pixel = candidate;
                            vec2 candidate_output =
                                (vec2(candidate) + 0.5) * vec2(output_size)
                                / vec2(source_size) - 0.5;
                            previous_color_pixel = clamp(
                                ivec2(round(candidate_output)), ivec2(0),
                                output_size - 1);
                        }
                    }
                }
            }
            if (candidate_found) {
                vec4 old_position = loadPreviousPosition(
                    previous_source_pixel,
                    ivec2(push.source_width, push.source_height));
                vec4 old_normal = loadPreviousNormal(previous_source_pixel);
                vec4 old_color = imageLoad(
                    previous_color, previous_color_pixel);
                float position_tolerance = max(
                    0.03, projected_depth * 0.01);
                float position_error = distance(
                    old_position.xyz, position_data.xyz);
                float normal_agreement = dot(
                    normalize(normal_data.xyz), normalize(old_normal.xyz));
                accepted = old_position.w >= 0.0 &&
                    position_error <= position_tolerance &&
                    normal_agreement > 0.9 &&
                    abs(old_normal.w - surface_class) < 0.25;
                history_confidence = min(
                    1.0 - smoothstep(
                        0.0, 1.0, position_error / position_tolerance),
                    smoothstep(0.9, 0.99, normal_agreement));
                old_hdr = old_color.rgb;
            }
        }
    }

    if (accepted) {
        vec3 neighborhood_min = vec3(1e30);
        vec3 neighborhood_max = vec3(-1e30);
        float luminance_sum = 0.0;
        float luminance_squared_sum = 0.0;
        float center_sample_luminance = 0.0;
        for (int y = -1; y <= 1; ++y)
            for (int x = -1; x <= 1; ++x) {
                vec3 sample_value = loadHdr(source_pixel + ivec2(x, y));
                neighborhood_min = min(neighborhood_min, sample_value);
                neighborhood_max = max(neighborhood_max, sample_value);
                float sample_luminance = luminance(sample_value);
                luminance_sum += sample_luminance;
                luminance_squared_sum += sample_luminance * sample_luminance;
                if (x == 0 && y == 0)
                    center_sample_luminance = sample_luminance;
            }
        float old_luminance = luminance(old_hdr);
        old_hdr = clamp(old_hdr, neighborhood_min, neighborhood_max);
        float weight = push.history_weight * history_confidence;
        if (surface_class > 1.5
                && push.material_confidence_enabled != 0u) {
            float current_luminance = luminance(hdr);
            float relative_delta = abs(old_luminance - current_luminance)
                / max(max(old_luminance, current_luminance), 0.05);
            float appearance_confidence = 1.0
                - smoothstep(0.05, 0.35, relative_delta);
            float transmission_scale = mix(
                0.05, push.transmission_history_scale,
                appearance_confidence);
            weight *= transmission_scale;
        } else if (surface_class > 0.5) {
            weight *= 0.25;
        } else if (push.variance_confidence_enabled != 0u) {
            float mean = luminance_sum / 9.0;
            float variance = max(
                luminance_squared_sum / 9.0 - mean * mean, 0.0);
            float relative_variance = variance / max(mean * mean, 0.001);
            float noisy = smoothstep(0.002, 0.05, relative_variance);
            float delta = luminance(old_hdr) - luminance(hdr);
            float agreement = exp(
                -(delta * delta) / max(4.0 * variance, 0.0005));
            float adaptive_weight = mix(
                push.history_weight,
                1.0 - (1.0 - push.history_weight)
                    * (1.0 - push.variance_confidence_strength),
                noisy * agreement);
            weight = adaptive_weight * history_confidence;
        }
        if (push.outlier_confidence_enabled != 0u) {
            float neighbor_mean =
                (luminance_sum - center_sample_luminance) / 8.0;
            float neighbor_variance = max(
                (luminance_squared_sum
                    - center_sample_luminance * center_sample_luminance) / 8.0
                    - neighbor_mean * neighbor_mean,
                0.0);
            float sigma = sqrt(max(
                neighbor_variance, neighbor_mean * neighbor_mean * 0.0005));
            float current_deviation =
                abs(luminance(hdr) - neighbor_mean) / max(sigma, 0.0005);
            float history_deviation =
                abs(old_luminance - neighbor_mean) / max(sigma, 0.0005);
            float class_threshold = surface_class > 0.5 ? 6.0 : 4.0;
            float current_outlier = smoothstep(
                class_threshold, class_threshold * 2.0, current_deviation);
            float history_compatible = 1.0 - smoothstep(
                class_threshold * 0.75, class_threshold * 1.5,
                history_deviation);
            float transient_outlier = current_outlier * history_compatible;
            float protected_weight = min(0.98, history_confidence);
            weight = mix(
                weight, max(weight, protected_weight),
                transient_outlier * push.outlier_confidence_strength);
        }
        hdr = mix(hdr, old_hdr, weight);
    }

    imageStore(history_color, output_pixel, vec4(max(hdr, vec3(0.0)), 1.0));
    vec3 mapped = acesApproximation(max(hdr, vec3(0.0)) * push.exposure);
    vec4 encoded = vec4(linearToSrgb(mapped), 1.0);
    uint effect_slot = effectSlotAt(source_pixel);
    vec2 output_uv = (vec2(output_pixel) + 0.5) / vec2(output_size);
    if (push.effect_header[0].x != 0u) {
        for (uint index = 0u; index < 4u; ++index) {
            uint kind = push.effect_header[index].x;
            float strength = uintBitsToFloat(push.effect_header[index].z);
            if (kind == 4u && effect_slot != index + 1u)
                encoded.rgb *= 1.0 - strength;
            if (kind == 5u || kind == 6u) {
                vec4 rect = push.effect_rect[index];
                vec2 thickness = vec2(push.effect_header[index].y) / vec2(output_size);
                bool valid_rect = rect.z > rect.x && rect.w > rect.y;
                bool inside = valid_rect && all(greaterThanEqual(output_uv, rect.xy))
                    && all(lessThanEqual(output_uv, rect.zw));
                bool border = inside && (
                    output_uv.x <= rect.x + thickness.x
                    || output_uv.x >= rect.z - thickness.x
                    || output_uv.y <= rect.y + thickness.y
                    || output_uv.y >= rect.w - thickness.y);
                if (kind == 6u && inside)
                    encoded.rgb = mix(encoded.rgb, push.effect_color[index].rgb,
                                      strength);
                if (border)
                    encoded.rgb = push.effect_color[index].rgb;
            }
        }
    }
    if (effect_slot > 0u && effect_slot <= 4u) {
        uint index = effect_slot - 1u;
        uint kind = push.effect_header[index].x;
        vec3 effect_color = push.effect_color[index].rgb;
        float strength = uintBitsToFloat(push.effect_header[index].z);
        if (kind == 2u)
            encoded.rgb = mix(encoded.rgb, effect_color, strength);
        else if (kind == 3u)
            encoded.rgb = min(encoded.rgb + effect_color * strength, vec3(1.0));
        else if (kind == 1u) {
        int radius = int(push.effect_header[index].y);
        bool boundary =
            effectSlotAt(source_pixel + ivec2(-radius, 0)) != effect_slot
            || effectSlotAt(source_pixel + ivec2(radius, 0)) != effect_slot
            || effectSlotAt(source_pixel + ivec2(0, -radius)) != effect_slot
            || effectSlotAt(source_pixel + ivec2(0, radius)) != effect_slot
            || effectSlotAt(source_pixel + ivec2(-radius, -radius)) != effect_slot
            || effectSlotAt(source_pixel + ivec2(radius, -radius)) != effect_slot
            || effectSlotAt(source_pixel + ivec2(-radius, radius)) != effect_slot
            || effectSlotAt(source_pixel + ivec2(radius, radius)) != effect_slot;
        if (boundary)
            encoded = vec4(effect_color, 1.0);
        }
    }
    imageStore(output_images[output_index], output_pixel, encoded);
}
