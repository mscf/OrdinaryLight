#version 460

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D output_image;
layout(set = 0, binding = 4, rgba32f) uniform readonly image2D accumulation_a;
layout(set = 0, binding = 6, rgba32f) uniform readonly image2D accumulation_b;
layout(set = 0, binding = 12, rgba32f) uniform readonly image2D filtered_a;
layout(set = 0, binding = 13, rgba32f) uniform readonly image2D filtered_b;

layout(push_constant) uniform Camera {
    vec4 origin;
    vec4 forward;
    vec4 right;
    vec4 up;
    vec4 overlay;
    vec4 accumulation;
    vec4 previous_origin;
    vec4 previous_forward;
    vec4 previous_right;
    vec4 previous_up;
    vec4 lighting;
} camera;

bool letterPixel(int letter, ivec2 p)
{
    if (any(lessThan(p, ivec2(0))) || p.x >= 5 || p.y >= 7) return false;
    if (letter == 0)
        return p.x == 0 || p.y == 0 || (p.y == 3 && p.x < 4);
    if (letter == 1)
        return p.x == 0 || ((p.y == 0 || p.y == 3) && p.x < 4) ||
               (p.x == 4 && p.y > 0 && p.y < 3);
    return p.y == 0 || p.y == 3 || p.y == 6 ||
           (p.x == 0 && p.y > 0 && p.y < 3) ||
           (p.x == 4 && p.y > 3 && p.y < 6);
}

bool digitPixel(int digit, ivec2 p)
{
    if (any(lessThan(p, ivec2(0))) || p.x >= 5 || p.y >= 9) return false;
    const uint masks[10] = uint[10](
        0x3fu, 0x06u, 0x5bu, 0x4fu, 0x66u,
        0x6du, 0x7du, 0x07u, 0x7fu, 0x6fu
    );
    uint mask = masks[clamp(digit, 0, 9)];
    bool a = (mask & 0x01u) != 0u && p.y <= 1 && p.x > 0 && p.x < 4;
    bool b = (mask & 0x02u) != 0u && p.x >= 3 && p.y > 0 && p.y < 4;
    bool c = (mask & 0x04u) != 0u && p.x >= 3 && p.y > 4 && p.y < 8;
    bool d = (mask & 0x08u) != 0u && p.y >= 7 && p.x > 0 && p.x < 4;
    bool e = (mask & 0x10u) != 0u && p.x <= 1 && p.y > 4 && p.y < 8;
    bool f = (mask & 0x20u) != 0u && p.x <= 1 && p.y > 0 && p.y < 4;
    bool g = (mask & 0x40u) != 0u && p.y >= 3 && p.y <= 5 && p.x > 0 && p.x < 4;
    return a || b || c || d || e || f || g;
}

vec3 fpsOverlay(uvec2 pixel, uvec2 size, vec3 color)
{
    if (camera.overlay.y < 0.5) return color;
    int scale = clamp(int(float(size.y) / 360.0 + 0.5), 2, 6);
    ivec2 logical = ivec2(pixel) / scale;
    if (logical.x >= 49 || logical.y >= 13) return color;
    color *= 0.22;
    ivec2 p = logical - ivec2(2);
    bool ink = letterPixel(0, p) || letterPixel(1, p - ivec2(6, 0)) ||
               letterPixel(2, p - ivec2(12, 0));
    int fps = clamp(int(camera.overlay.x + 0.5), 0, 9999);
    int digits = fps >= 1000 ? 4 : (fps >= 100 ? 3 : (fps >= 10 ? 2 : 1));
    for (int i = 0; i < 4; ++i) {
        if (i >= digits) break;
        int divisor = i == 0 ? 1000 : (i == 1 ? 100 : (i == 2 ? 10 : 1));
        if (digits < 4) divisor = digits == 3 ? (i == 0 ? 100 : (i == 1 ? 10 : 1)) :
                                      (digits == 2 ? (i == 0 ? 10 : 1) : 1);
        int digit = (fps / divisor) % 10;
        ink = ink || digitPixel(digit, p - ivec2(20 + i * 6, 0));
    }
    return ink ? vec3(0.35, 1.0, 0.45) : color;
}

void main()
{
    uvec2 pixel = gl_GlobalInvocationID.xy;
    uvec2 size = uvec2(camera.origin.w, camera.forward.w);
    if (any(greaterThanEqual(pixel, size))) return;
    bool read_a = (int(camera.accumulation.x) & 1) == 0;
    int denoise_iterations = int(camera.lighting.w);
    vec3 hdr;
    if (denoise_iterations > 0)
        hdr = (denoise_iterations & 1) == 1
            ? imageLoad(filtered_a, ivec2(pixel)).rgb
            : imageLoad(filtered_b, ivec2(pixel)).rgb;
    else
        hdr = read_a ? imageLoad(accumulation_a, ivec2(pixel)).rgb
                     : imageLoad(accumulation_b, ivec2(pixel)).rgb;
    vec3 color = pow(hdr / (vec3(1.0) + hdr), vec3(1.0 / 2.2));
    color = fpsOverlay(pixel, size, color);
    imageStore(output_image, ivec2(pixel), vec4(color, 1.0));
}
