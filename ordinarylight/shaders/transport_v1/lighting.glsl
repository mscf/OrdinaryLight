float ordinarylight_unified_secondary_area_probability(bool area_enabled, bool environment_enabled, float area_light_weight, uint secondary_area_samples, uint environment_samples);
float randomFloat(inout uint state);
vec3 sampleAreaLightTechnique(vec3 hit, vec3 normal, vec3 incoming, MaterialData material, inout uint rng, uint sample_index, uint sample_count, float technique_probability);
vec3 sampleEnvironmentTechnique(vec3 hit, vec3 normal, vec3 incoming, MaterialData material, inout uint rng, uint sample_count, float technique_probability);
vec3 sampleUnifiedSecondaryLight(vec3 hit, vec3 normal, vec3 incoming, MaterialData material, inout uint rng)
{
    bool area_enabled = (OL_TRANSPORT_AREA_LIGHT_COUNT > uint(0));
    bool environment_enabled = (OL_TRANSPORT_ENVIRONMENT_SAMPLES > uint(0));
    if (((!area_enabled) && (!environment_enabled)))
    {
        return vec3(0.0);
    }
    float area_probability = ordinarylight_unified_secondary_area_probability(area_enabled, environment_enabled, OL_TRANSPORT_AREA_LIGHT_WEIGHT, OL_TRANSPORT_SECONDARY_AREA_LIGHT_SAMPLES, OL_TRANSPORT_ENVIRONMENT_SAMPLES);
    if ((randomFloat(rng) < area_probability))
    {
        return sampleAreaLightTechnique(hit, normal, incoming, material, rng, uint(0), uint(1), area_probability);
    }
    return sampleEnvironmentTechnique(hit, normal, incoming, material, rng, uint(1), (1.0 - area_probability));
}

