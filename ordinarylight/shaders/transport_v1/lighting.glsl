    float unused_distance = float(0.0);
    vec3 contribution = evaluateAreaLightCandidate(candidate, hit, normal, incoming, material, sample_count, unused_direction, unused_distance);
    candidate.target = ordinarylight_light_candidate_target(contribution);
    return candidate;
}

void profileWork(uint counter, uint amount);
float volumeShadowTransmittance(vec3 origin, vec3 direction, float maximum_distance);
float areaLightCandidateVisibility(vec3 hit, vec3 normal, vec3 direction, float distance_to_light)
{
    if ((distance_to_light <= 0.0))
    {
        return 0.0;
    }
    vec3 shadow_origin = OL_TRANSPORT_RAY_ORIGIN(hit, normal);
    float shadow_distance = max((distance_to_light - 0.004), 0.001);
    rayQueryEXT shadow;
#if WAVE_WORK_COUNTERS
    profileWork(uint(1), uint(1));
#endif
    rayQueryInitializeEXT(shadow, scene_tlas, (gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT), 1, shadow_origin, 0.001, direction, shadow_distance);
    while (rayQueryProceedEXT(shadow))
    {
    }
    if ((rayQueryGetIntersectionTypeEXT(shadow, true) != gl_RayQueryCommittedIntersectionNoneEXT))
    {
        return 0.0;
    }
    return volumeShadowTransmittance(shadow_origin, direction, shadow_distance);
}

vec3 ordinarylight_environment_analytic(vec3 direction);
vec3 ordinarylight_environment_radiance(vec3 encoded, float exposure, vec3 color, float intensity, bool textured);
vec2 ordinarylight_environment_uv(vec3 direction, float rotation);
vec4 sampleSceneTexture(int texture_index, vec2 uv);
vec3 environmentColor(vec3 direction)
{
    uint index = uint(0);
    while ((index < min(OL_TRANSPORT_POINT_LIGHT_COUNT, uint(64))))
    {
        PointLightData light = point_lights[index];
        if ((int((light.position_type.w + 0.5)) != 3))
        {
            index = (index + 1);
            continue;
        }
        vec3 radiance = vec3(1.0);
        int texture_index = ((light.spot_parameters.x < 0.0) ? (-1) : int((light.spot_parameters.x + 0.5)));
        if ((texture_index >= 0))
        {
            vec2 uv = ordinarylight_environment_uv(direction, light.spot_parameters.y);
            vec3 encoded = sampleSceneTexture(texture_index, uv).rgb;
            radiance = ordinarylight_environment_radiance(encoded, light.spot_parameters.z, vec3(1.0), 1.0, true);
        }
        return ordinarylight_environment_radiance(radiance, 0.0, light.color_intensity.rgb, light.color_intensity.a, false);
        index = (index + 1);
    }
    return ordinarylight_environment_analytic(direction);
}

vec3 environmentColor(vec3 direction);
vec3 evaluatePbr(MaterialData material, vec3 normal, vec3 view, vec3 outgoing);
float ordinarylight_analytic_light_cosine(vec3 normal, vec3 direction);
vec3 ordinarylight_environment_contribution(vec3 evaluated_pbr, vec3 radiance, float cosine, float mis, float transmittance, float effective_pdf, float occlusion, float metallic);
float ordinarylight_environment_effective_pdf(float cosine, float technique_probability);
float ordinarylight_environment_mis(float cosine, float effective_pdf, float sample_count);
vec3 ordinarylight_pbr_cosine_hemisphere(vec3 normal, float random_u, float random_v);
void profileWork(uint counter, uint amount);
float randomFloat(inout uint state);
float volumeShadowTransmittance(vec3 origin, vec3 direction, float maximum_distance);
vec3 sampleEnvironmentTechnique(vec3 hit, vec3 normal, vec3 incoming, MaterialData material, inout uint rng, uint sample_count, float technique_probability)
{
    vec3 direction = ordinarylight_pbr_cosine_hemisphere(normal, randomFloat(rng), randomFloat(rng));
    vec3 shadow_origin = OL_TRANSPORT_RAY_ORIGIN(hit, normal);
    rayQueryEXT shadow;
#if WAVE_WORK_COUNTERS
    profileWork(uint(1), uint(1));
#endif
    rayQueryInitializeEXT(shadow, scene_tlas, (gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT), 1, shadow_origin, 0.001, direction, 1e+30);
    while (rayQueryProceedEXT(shadow))
    {
    }
    if ((rayQueryGetIntersectionTypeEXT(shadow, true) != gl_RayQueryCommittedIntersectionNoneEXT))
    {
        return vec3(0.0);
    }
    float cosine = ordinarylight_analytic_light_cosine(normal, direction);
    float pdf = (cosine / 3.14159265359);
    float effective_pdf = ordinarylight_environment_effective_pdf(cosine, technique_probability);
    float mis = ordinarylight_environment_mis(cosine, effective_pdf, float(sample_count));
    float transmittance = volumeShadowTransmittance(shadow_origin, direction, 1e+30);
    return ordinarylight_environment_contribution(evaluatePbr(material, normal, (-incoming), direction), environmentColor(direction), cosine, mis, transmittance, effective_pdf, material.texture_parameters.w, material.emission_metallic.a);
}

vec3 sampleEnvironmentTechnique(vec3 hit, vec3 normal, vec3 incoming, MaterialData material, inout uint rng, uint sample_count, float technique_probability);
