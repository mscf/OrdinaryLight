#version 460

// One invocation converts a 4x2 luma block and its two 2x2 chroma samples.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image2D rgba_input;
layout(set = 0, binding = 1, std430) writeonly buffer Nv12Output {
    uint words[];
} output_buffer;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint pitch;
    uint reserved;
} push;

uint byteValue(float value)
{
    return uint(clamp(round(value), 0.0, 255.0));
}

uint luma(vec3 rgb)
{
    // BT.709, limited-range studio swing, operating on sRGB-like R'G'B'.
    return byteValue(16.0 + 219.0 * dot(
        rgb, vec3(0.2126, 0.7152, 0.0722)));
}

uvec2 chroma(vec3 rgb)
{
    float cb = dot(rgb, vec3(-0.114572, -0.385428, 0.5));
    float cr = dot(rgb, vec3(0.5, -0.454153, -0.045847));
    return uvec2(byteValue(128.0 + 224.0 * cb),
                 byteValue(128.0 + 224.0 * cr));
}

vec3 loadRgb(ivec2 pixel)
{
    return imageLoad(rgba_input, clamp(
        pixel, ivec2(0), ivec2(int(push.width), int(push.height)) - 1
    )).rgb;
}

uint pack4(uint a, uint b, uint c, uint d)
{
    return a | (b << 8u) | (c << 16u) | (d << 24u);
}

void main()
{
    uvec2 block = gl_GlobalInvocationID.xy;
    uint x = block.x * 4u;
    uint y = block.y * 2u;
    if (x >= push.width || y >= push.height)
        return;

    vec3 top[4];
    vec3 bottom[4];
    for (uint column = 0u; column < 4u; ++column) {
        top[column] = loadRgb(ivec2(x + column, y));
        bottom[column] = loadRgb(ivec2(x + column, y + 1u));
    }

    uint words_per_row = push.pitch / 4u;
    output_buffer.words[y * words_per_row + x / 4u] = pack4(
        luma(top[0]), luma(top[1]), luma(top[2]), luma(top[3]));
    if (y + 1u < push.height) {
        output_buffer.words[(y + 1u) * words_per_row + x / 4u] = pack4(
            luma(bottom[0]), luma(bottom[1]),
            luma(bottom[2]), luma(bottom[3]));
    }

    vec3 first = 0.25 * (
        top[0] + top[1] + bottom[0] + bottom[1]);
    vec3 second = 0.25 * (
        top[2] + top[3] + bottom[2] + bottom[3]);
    uvec2 uv0 = chroma(first);
    uvec2 uv1 = chroma(second);
    uint chroma_word = push.pitch * push.height / 4u
        + (y / 2u) * words_per_row + x / 4u;
    output_buffer.words[chroma_word] = pack4(
        uv0.x, uv0.y, uv1.x, uv1.y);
}
