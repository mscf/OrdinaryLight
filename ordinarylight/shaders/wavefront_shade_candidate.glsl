WavePathState shadeIntegrateVolumesBeforeSurfaceConfigured(WavePathState input_path, vec3 origin, vec3 direction, float surface_distance, bool overlapping_enabled, bool empty_space_skipping, bool scattering_enabled, bool multiple_scattering, uint point_light_count, uint area_light_count, uint environment_sample_count, vec3 environment_radiance_0, vec3 environment_radiance_1, vec3 environment_radiance_2, vec3 environment_radiance_3)
