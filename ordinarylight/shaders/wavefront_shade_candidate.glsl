MaterialData shadeApplyMaterialEvaluation(MaterialData input_material, MaterialEvaluation evaluated)
{
    MaterialData material = input_material;
    material.base_roughness = vec4(evaluated.base_color, evaluated.roughness);
    material.emission_metallic = vec4(evaluated.emission, evaluated.metallic);
    material.attenuation_transmission = vec4(evaluated.attenuation_color, evaluated.transmission);
    material.ior_distance.xy = vec2(evaluated.ior, evaluated.attenuation_distance);
    return material;
}

