#version 460

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct WavePathState {
    vec4 throughput;
    vec4 radiance;
    uvec4 metadata;
};

layout(set = 0, binding = 0, std430) readonly buffer PathStates {
    WavePathState paths[];
};
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D output_image;

layout(push_constant) uniform PushConstants {
    uint path_count;
    float exposure;
    uint image_width;
    uint image_height;
} push;

vec3 acesApproximation(vec3 color)
{
    const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
    return clamp((color * (a * color + b)) /
                 (color * (c * color + d) + e), 0.0, 1.0);
}

vec3 linearToSrgb(vec3 color)
{
    bvec3 low = lessThanEqual(color, vec3(0.0031308));
    return mix(1.055 * pow(color, vec3(1.0 / 2.4)) - 0.055,
               color * 12.92, low);
}

void main()
{
    uint path_index = gl_GlobalInvocationID.x;
    if (path_index >= push.path_count)
        return;
    uint pixel_index = paths[path_index].metadata.x;
    ivec2 source_pixel = ivec2(
        int(pixel_index % push.image_width), int(pixel_index / push.image_width)
    );
    if (source_pixel.y >= int(push.image_height))
        return;
    vec3 mapped = acesApproximation(
        max(paths[path_index].radiance.rgb, vec3(0.0)) * push.exposure
    );
    vec4 output_color = vec4(linearToSrgb(mapped), 1.0);
    ivec2 output_size = imageSize(output_image);
    ivec2 first = ivec2(
        source_pixel.x * output_size.x / int(push.image_width),
        source_pixel.y * output_size.y / int(push.image_height)
    );
    ivec2 last = ivec2(
        (source_pixel.x + 1) * output_size.x / int(push.image_width),
        (source_pixel.y + 1) * output_size.y / int(push.image_height)
    );
    last = max(last, first + ivec2(1));
    for (int y = first.y; y < min(last.y, output_size.y); ++y)
        for (int x = first.x; x < min(last.x, output_size.x); ++x)
            imageStore(output_image, ivec2(x, y), output_color);
}
